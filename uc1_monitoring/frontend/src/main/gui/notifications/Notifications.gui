package notifications;

import MonitoringDT.Notification;

import layout.DTLayout;
import mc.fenix.arrange.GemColumn;
import mc.fenix.basic.GemText;
import mc.fenix.table.GemTable;
import mc.fenix.table.GemTableHeader;
import mc.fenix.table.GemTableRow;
import mc.fenix.input.GemCheckBoxInput;
import mc.fenix.input.GemTextInput;

page Notifications (List<Notification> notifications, LimitConfiguration config) {
  @DTLayout(content =
    @GemColumn(width = "100%", rowGap = "16px", components = [
      @GemTextInput(labelText = "Warning limit", entry = config.warnLimit, height = "3em"),
      @GemTextInput(labelText = "Error limit", entry = config.errorLimit, height = "3em"),
      @GemText(value = "Notifications", size = "2rem", weight = "bold"),
      @GemTable(
        headers = [@GemTableHeader(cols = ["Issued", "Message", "Seen"])],
        height = "70vh",
        body = [@iterate(Notification notification : notifications) {
          @GemTableRow(cols = [
            @GemText(value = notification.issued.toString()),
            @GemText(value = notification.content),
            @GemCheckBoxInput(checked = notification.seen)
          ]);
        }]
      )
    ])
  );
}
